{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "files": ["**/*.{go,md,yml,yaml,toml,json,jsonc}"],
  "words": [
    "depguard",
    "dprint",
    "errcheck",
    "errorlint",
    "forgetest",
    "gocognit",
    "gochecknoglobals",
    "gocritic",
    "gofmt",
    "gofumpt",
    "goimports",
    "golangci",
    "gosec",
    "govet",
    "govulncheck",
    "ineffassign",
    "jeffzi",
    "lefthook",
    "misspell",
    "nilerr",
    "modernize",
    "nestif",
    "noctx",
    "nolint",
    "prek",
    "revive",
    "semver",
    "staticcheck",
    "Taskfile",
    "taskkill",
    "zizmor",
    "covermode",
    "coverprofile",
    "NOSYSTEM",
    "USERPROFILE",
    "gittest",
    "gpgsign",
    "symref",
    "synctest",
    "ghtest",
    "GORACE",
    "atexit",
    "cmpopts",
    "gotest"
  ],
  "ignorePaths": [
    ".planning",
    ".research"
  ]
}
